# ================================================================
# AGAP Emergency Response Platform — Environment Variables
# ================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env or any file containing real secrets.
# ================================================================

# --- Database ---
DATABASE_URL=postgresql://agap_user:agap_password@localhost:5432/agap_db?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Firebase Cloud Messaging ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- SMS Provider ---
# Supported: semaphore | twilio | placeholder
SMS_PROVIDER=semaphore
SMS_API_KEY=
SMS_SENDER_NAME=AGAP

# --- Map Provider ---
MAP_PROVIDER=mapbox
MAP_API_KEY=

# --- Object Storage ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=agap-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-southeast-1

# --- Backend ---
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_MAP_API_KEY=

# --- Mobile ---
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- Admin ---
INITIAL_ADMIN_EMAIL=admin@agap.local
INITIAL_ADMIN_PASSWORD=
