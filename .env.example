# ================================================================
# AGAP Emergency Response Platform — Environment Variables
# ================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env or any file containing real secrets.
# ================================================================

# --- Database ---
# Use 127.0.0.1 (not "localhost"). On Windows/Node 18+, "localhost" resolves to
# IPv6 ::1 first; Docker Desktop's IPv6 port-forward accepts the TCP socket but
# never completes the Postgres handshake, so pg hangs until connection timeout.
DATABASE_URL=postgresql://agap_user:agap_password@127.0.0.1:5432/agap_db?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Web session cookie / proxy ---
COOKIE_SECURE=                  # true|false; blank = Secure only when NODE_ENV=production
COOKIE_DOMAIN=                  # blank = host-only cookie (recommended)
TRUST_PROXY=loopback, linklocal, uniquelocal   # hops allowed to set X-Forwarded-For (nginx)

# --- Web-console MFA (docs/plans/WEB_AUTH_SECURITY_PLAN.md Phase 3) ---
# 32 random bytes, base64. Seals authenticator-app (TOTP) seeds at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Blank = authenticator-app enrollment is unavailable (passkeys still work). Losing or rotating this key
# makes every enrolled authenticator app unusable until staff re-enroll (backup codes still work).
MFA_ENCRYPTION_KEY=
# false during the 1-2 week enrollment window: staff are offered MFA and only enrolled users are asked for it.
# true once everyone has enrolled: staff with no second factor must enroll at next sign-in. Requires MFA_ENCRYPTION_KEY.
AUTH_MFA_ENFORCED=false
# false (recommended): no SMS second factor. The single Textbee SIM also carries emergency traffic and SIM-swap is a known attack.
AUTH_SMS_MFA_ENABLED=false

# --- Firebase Cloud Messaging (backend service account) ---
# From Firebase console → Project settings → Service accounts → Generate new private key.
# Not from google-services.json. Keep the private key on one line, double-quoted, with its \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- SMS Gateway (Textbee — textbee.dev) ---
# Textbee sends SMS via an Android device running the Textbee app with a local SIM.
# Get API key and device ID from https://textbee.dev/dashboard
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Phone number of the MDRRMO Operations Center that receives incoming alert SMS
MDRRMO_OPS_PHONE=

# --- Barangay alert SMS (MOD-17 / MOD-34) ---
# 'true' = text the barangay's primary + backup numbers when a report is submitted
# (information only; MDRRMO triage carries on). Keep 'false' until MDRRMO verifies
# the numbers in docs/automation/barangay-contact-confirmation.md.
BARANGAY_ALERTS_ENABLED=false
# Every barangay SMS goes here instead of the barangay. Required outside production
# while alerts are on (the backend refuses to boot without it). PH mobile, e.g. 09171234567.
BARANGAY_SMS_TEST_OVERRIDE_PHONE=
# Minutes to wait for the barangay to report back before one reminder SMS and the
# "has not reported back" banner. Default 20; use 1 to test.
BARANGAY_FOLLOWUP_MINUTES=20
# Phase 5: read barangay SMS replies (e.g. "DONE 3526") sent to the Textbee phone. A reply
# never changes incident status. Needs "Receive SMS" on in the Textbee app.
BARANGAY_SMS_REPLIES_ENABLED=false
# poll (default; reads Textbee every 15 s, no public URL needed). webhook is not built yet.
BARANGAY_SMS_INBOUND_MODE=poll
# Public base URL of the web app (no trailing slash). Barangays save <PUBLIC_APP_URL>/b
# on their phone once, then type the access code from the alert SMS (e.g. 3470-KXPM) to
# open the page with the exact location and the status buttons (seen / acting / on scene
# / completed / needs backup). The SMS itself never carries a web address: PH carriers
# drop P2P texts that contain one. Must be reachable from the barangay's phone.
PUBLIC_APP_URL=
# Optional dedicated key for the access codes (falls back to one derived from JWT_SECRET).
BARANGAY_LINK_SECRET=

# --- Map Provider (MOD-11/12/13/43) ---
# Tile/static-image vendor. "mapbox" (default) or "maplibre"/"osm" for self-hosted.
MAP_PROVIDER=mapbox
# Public (pk.*) Mapbox token. Also shipped to clients as EXPO_/NEXT_PUBLIC_MAP_API_KEY.
MAP_API_KEY=
# Routing engine for ETA: "osrm" (free, free-flow; default) or "mapbox"
# (traffic-aware driving-traffic profile; requires MAP_API_KEY).
MAP_ROUTER=osrm
# OSRM-compatible routing service (used when MAP_ROUTER=osrm). Self-host for cost/surge resilience.
MAP_PROVIDER_ROUTING_URL=http://router.project-osrm.org
# Reverse-geocoding service (Nominatim-compatible). Self-host a Bulacan OSM extract.
MAP_GEOCODER_URL=https://nominatim.openstreetmap.org
# MapLibre/OSM style or TileJSON URL (used when MAP_PROVIDER=maplibre).
# Must be a standard HTTPS vector tile style (OpenMapTiles schema) — not a mapbox:// URL.
# When set, the backend advertises supports3dBuildings=true and the mobile map renders
# fill-extrusion building footprints at zoom ≥ 14.
# - MapTiler free tier (75k req/mo): https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
# - Self-hosted tileserver-gl:       http://tileserver:8080/styles/basic/style.json
# Leave empty to fall back to the MapLibre demo style (no 3D buildings).
MAP_STYLE_URL=

# --- Object Storage ---
# Dev: MinIO (docker-compose). Prod: S3-compatible bucket (AWS S3, DigitalOcean Spaces, etc.)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=agap-media
STORAGE_ACCESS_KEY=agap
STORAGE_SECRET_KEY=agap_secret
STORAGE_REGION=us-east-1

# --- Backend ---
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_MAP_API_KEY=

# --- Mobile ---
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000
EXPO_PUBLIC_MAP_API_KEY=       # same Mapbox public token as MAP_API_KEY
EXPO_PUBLIC_PASSKEY_RP_ID=     # same as WEBAUTHN_RP_ID; adds the iOS webcredentials associated domain

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- Admin ---
INITIAL_ADMIN_EMAIL=admin@agap.local
INITIAL_ADMIN_PASSWORD=AgapDev2026!

# --- WebAuthn / Passkeys ---
# rpID must match the domain (no protocol, no port) the frontend is served from
WEBAUTHN_RP_ID=localhost
# Comma-separated origins (protocol + host + port) allowed to complete a ceremony.
# Native iOS passkeys report https://<WEBAUTHN_RP_ID>, so include it when the mobile app is used.
WEBAUTHN_ORIGIN=http://localhost:3000
# Mobile passkeys (Android Credential Manager / iOS AuthenticationServices) require WEBAUTHN_RP_ID
# to be a real HTTPS domain whose /.well-known/* is routed to this backend.
# Comma-separated SHA-256 signing-cert fingerprints ("AB:CD:..."), e.g. from `eas credentials`.
# Each is used for assetlinks.json AND accepted as an android:apk-key-hash:<…> origin.
WEBAUTHN_ANDROID_CERT_FINGERPRINTS=
WEBAUTHN_ANDROID_PACKAGE=com.agap.emergency
# Comma-separated "<TEAM_ID>.<bundle id>" entries for apple-app-site-association
WEBAUTHN_IOS_APP_IDS=
