{
  "name": "@agap/backend",
  "version": "0.1.0",
  "private": true,
  "description": "AGAP Backend — NestJS REST API and WebSocket server",
  "scripts": {
    "clean": "node scripts/clean-dist.js",
    "prebuild": "node scripts/clean-dist.js",
    "build": "nest build",
    "start": "node dist/main",
    "prestart:dev": "node scripts/clean-dist.js",
    "start:dev": "nest start --watch",
    "prestart:debug": "node scripts/clean-dist.js",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --config ./test/jest.config.ts",
    "test:watch": "jest --config ./test/jest.config.ts --watch",
    "test:cov": "jest --config ./test/jest.config.ts --coverage",
    "test:e2e": "jest --config ./test/jest.config.ts --testMatch \"**/test/**/*.e2e-spec.ts\" --passWithNoTests --runInBand",
    "test:e2e:db": "ts-node --transpile-only test/e2e/setup-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed/seed.ts",
    "db:reset-data": "prisma db execute --file ../scripts/db/reset-data.sql",
    "dev:reset-dispatcher": "ts-node scripts/reset-dispatcher-password.ts",
    "medical:encrypt": "ts-node scripts/encrypt-medical-profiles.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@agap/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@google/genai": "2.30.0",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.0",
    "@nestjs/websockets": "^10.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/multer": "^2.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.25.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "cookie-parser": "1.4.7",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "multer": "^2.4.0",
    "openai": "^7.42.0",
    "otplib": "12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "tesseract.js": "7.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv": "^16.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prisma": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
