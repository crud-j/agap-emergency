  incident_id            String                  @db.Uuid
  barangay_id            String
  match_method           barangay_match_method
  is_approximate         Boolean                 @default(false)
  short_code             String                  @db.VarChar(4)
  sms_status             barangay_sms_status     @default(PENDING)
  sms_sent_at            DateTime?               @db.Timestamptz(6)
  last_report            barangay_report_type?
  last_report_source     barangay_report_source?
  last_report_at         DateTime?               @db.Timestamptz(6)
  last_report_by_user_id String?                 @db.Uuid
  followup_due_at        DateTime?               @db.Timestamptz(6)
  followup_sent_at       DateTime?               @db.Timestamptz(6)
  closed_at              DateTime?               @db.Timestamptz(6)
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  incidents              Incident                @relation(fields: [incident_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  barangay               geo_regions             @relation(fields: [barangay_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  last_report_by         User?                   @relation("BarangayNoticeReporter", fields: [last_report_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  inbound_messages       barangay_sms_inbound[]

  @@unique([incident_id, barangay_id], map: "uq_incident_barangay_notices_incident_barangay")
  @@index([incident_id], map: "idx_incident_barangay_notices_incident")
  @@index([barangay_id, created_at(sort: Desc)], map: "idx_incident_barangay_notices_barangay")
}

/// Append-only log of every SMS received from a barangay, applied or not. Application code
/// only INSERTs. `provider_message_id` makes webhook retries and re-polls idempotent.
model barangay_sms_inbound {
  id                  String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  provider_message_id String                     @unique(map: "uq_barangay_sms_inbound_provider_message") @db.VarChar(100)
  from_phone          String                     @db.VarChar(32)
  from_phone_e164     String?                    @db.VarChar(16)
  body                String
  received_at         DateTime                   @db.Timestamptz(6)
  parsed_command      String?                    @db.VarChar(12)
  parsed_code         String?                    @db.VarChar(4)
  notice_id           String?                    @db.Uuid
  outcome             barangay_inbound_outcome
  created_at          DateTime                   @default(now()) @db.Timestamptz(6)
  notice              incident_barangay_notices? @relation(fields: [notice_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([notice_id], map: "idx_barangay_sms_inbound_notice")
  @@index([received_at(sort: Desc)], map: "idx_barangay_sms_inbound_received")
}

