generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, postgis, uuid_ossp(map: "uuid-ossp")]
}

model User {
  id                                                                       String                         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  full_name                                                                String                         @db.VarChar(255)
  email                                                                    String?                        @unique @db.VarChar(255)
  phone_number                                                             String?                        @unique @db.VarChar(20)
  password_hash                                                            String?                        @db.VarChar(255)
  role                                                                     user_role                      @default(CITIZEN)
  status                                                                   user_status                    @default(PENDING_VERIFICATION)
  must_change_password                                                     Boolean                        @default(false)
  password_changed_at                                                      DateTime?                      @db.Timestamptz(6)
  /// Failed password / second-factor attempts since the last lock or successful sign-in (web-console roles only).
  failed_login_count                                                       Int                            @default(0) @db.SmallInt
  /// While in the future the account refuses sign-ins (trusted browsers are exempt). Cleared by a completed sign-in.
  locked_until                                                             DateTime?                      @db.Timestamptz(6)
  /// 0, 1, 2+ → 15, 30, 60 minute locks. Reset by a completed sign-in.
  lockout_level                                                            Int                            @default(0) @db.SmallInt
  profile_completeness                                                     Int                            @default(0) @db.SmallInt
  is_guest                                                                 Boolean                        @default(false)
  is_email_verified                                                        Boolean                        @default(false)
  is_phone_verified                                                        Boolean                        @default(false)
  barangay                                                                 String?                        @db.VarChar(100)
  municipality                                                             String?                        @default("Bocaue") @db.VarChar(100)
  province                                                                 String?                        @default("Bulacan") @db.VarChar(100)
  full_address                                                             String?
  preferred_language                                                       String                         @default("fil") @db.VarChar(10)
  last_login_at                                                            DateTime?                      @db.Timestamptz(6)
  created_at                                                               DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                                                               DateTime                       @default(now()) @db.Timestamptz(6)
  created_by_id                                                            String?                        @db.Uuid
  high_contrast                                                            Boolean                        @default(false)
  reduced_motion                                                           Boolean                        @default(false)
  text_size                                                                String                         @default("medium") @db.VarChar(10)
  /// Optional, self-declared reporter sex — used only for the reporter's map icon.
  /// null = never asked (legacy, guests, admin-created); PREFER_NOT_TO_SAY = asked and declined.
  /// Personal data, NOT patient data (patient sex lives on incident_patients).
  sex                                                                      user_sex?
  /// MOD-01: set when the PhilHealth ID name matched at registration or staff approved it.
  /// Information only — never affects priority, recommendations or dispatch (rule 8).
  identity_verified_at                                                     DateTime?                      @db.Timestamptz(6)
  identity_verifications                                                   identity_verifications[]       @relation("IdentityVerificationUser")
  reviewed_identity_verifications                                          identity_verifications[]       @relation("IdentityVerificationReviewer")
  account_lifecycle_events_account_lifecycle_events_performed_by_idTousers account_lifecycle_events[]     @relation("account_lifecycle_events_performed_by_idTousers")
  account_lifecycle_events_account_lifecycle_events_user_idTousers         account_lifecycle_events[]     @relation("account_lifecycle_events_user_idTousers")
  alert_triggers                                                           alert_triggers[]
  announcement_deliveries                                                  announcement_deliveries[]
  announcements_announcements_approved_by_idTousers                        Announcement[]                 @relation("announcements_approved_by_idTousers")
  announcements_announcements_approval_requested_by_idTousers              Announcement[]                 @relation("announcements_approval_requested_by_idTousers")
  announcements                                                            Announcement[]                 @relation("announcement_publisher")
  audit_logs                                                               AuditLog[]
  consent_records                                                          consent_records[]
  device_readiness_reports                                                 device_readiness_reports[]
  dispatch_crew                                                            dispatch_crew[]
  dispatches                                                               dispatches[]
  emergency_contacts                                                       EmergencyContact[]
  escalations                                                              Escalation[]
  facility_referrals                                                       facility_referrals[]
  facilities_location_verified                                             Facility[]                     @relation("FacilityLocationVerifiedBy")
  transport_reporter_patient_confirmations                                 TransportRecord[]              @relation("TransportReporterPatientConfirmedBy")
  false_alerts_false_alerts_classified_by_idTousers                        false_alerts[]                 @relation("false_alerts_classified_by_idTousers")
  false_alerts_false_alerts_user_idTousers                                 false_alerts[]                 @relation("false_alerts_user_idTousers")
  feedback_ratings                                                         feedback_ratings[]
  ics_assignments                                                          ics_assignments[]
  incident_agency_participants                                             incident_agency_participants[]
  incident_attachments                                                     IncidentAttachment[]           @relation("incident_attachments_uploaded_by_idTousers")
  incident_attachments_rejected                                            IncidentAttachment[]           @relation("incident_attachments_rejected_by_idTousers")
  incident_events                                                          IncidentEvent[]
  incident_handovers_incident_handovers_from_user_idTousers                incident_handovers[]           @relation("incident_handovers_from_user_idTousers")
  incident_handovers_incident_handovers_to_user_idTousers                  incident_handovers[]           @relation("incident_handovers_to_user_idTousers")
  incident_messages                                                        incident_messages[]
  incident_patients                                                        incident_patients[]
  incident_reporters                                                       IncidentReporter[]
  incident_resolutions                                                     incident_resolutions[]
  location_history                                                         location_history[]
  medical_profiles                                                         MedicalProfile?
  message_reads                                                            message_reads[]
  notifications                                                            Notification[]
  offline_event_queue                                                      offline_event_queue[]
  on_scene_assessments                                                     on_scene_assessments[]
  fire_field_reports                                                       fire_field_reports[]
  rescue_trip_reports                                                      rescue_trip_reports[]
  organization_memberships                                                organization_memberships[]
  resource_status_log                                                      resource_status_log[]
  responder_availability_changes                                           ResponderAvailability[]        @relation("responderAvailabilityChangedBy")
  responder_availability_user                                              ResponderAvailability?         @relation("responderAvailabilityUser")
  resource_crew_membership                                                 resource_crew_members?
  sensitive_data_access_log                                                sensitive_data_access_log[]
  sms_subscribers                                                          sms_subscribers[]
  surge_incidents                                                          surge_incidents[]
  system_configurations                                                    system_configurations[]
  triage_tags                                                              triage_tags[]
  user_sessions                                                            user_sessions[]
  user_mfa_totp                                                            user_mfa_totp?
  user_backup_codes                                                        user_backup_codes[]
  trusted_devices                                                          trusted_devices[]
  user_verifications                                                       user_verifications[]
  users                                                                    User?                          @relation("usersTousers", fields: [created_by_id], references: [id], onUpdate: NoAction)
  other_users                                                              User[]                         @relation("usersTousers")
  webauthn_authentication_log                                              webauthn_authentication_log[]
  webauthn_challenges                                                      webauthn_challenges[]
  webauthn_credentials                                                     webauthn_credentials[]
  barangay_notice_reports                                                  incident_barangay_notices[]    @relation("BarangayNoticeReporter")
  surge_river_readings                                                     surge_settings[]
  reviewed_risk_area_proposals                                             risk_area_proposals[]
  requested_ai_suggestions                                                 ai_suggestions[]               @relation("AiSuggestionRequester")
  reviewed_ai_suggestions                                                  ai_suggestions[]               @relation("AiSuggestionReviewer")

  @@index([barangay], map: "idx_users_barangay")
  @@index([created_at(sort: Desc)], map: "idx_users_created_at")
  @@index([full_name(ops: raw("gin_trgm_ops"))], map: "idx_users_name_trgm", type: Gin)
  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model EmergencyContact {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String   @db.Uuid
  contact_name    String   @db.VarChar(255)
  relationship    String?  @db.VarChar(100)
  phone_number    String   @db.VarChar(20)
  email           String?  @db.VarChar(255)
  priority_order  Int      @default(1) @db.SmallInt
  notify_on_alert Boolean  @default(true)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  users           User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_emergency_contacts_user")
  @@map("emergency_contacts")
}

model MedicalProfile {
  id                  String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id             String              @unique @db.Uuid
  consent_record_id   String              @db.Uuid
  /// Medical fields below are AES-256-GCM sealed by MedicalCryptoService (MEDICAL_ENCRYPTION_KEY).
  blood_type          String?
  allergies           String[]
  current_medications String[]
  medical_conditions  String[]
  disabilities        String[]
  responder_notes     String?
  last_reviewed_at    DateTime?           @db.Timestamptz(6)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  incident_patients   incident_patients[]
  consent_records     consent_records     @relation(fields: [consent_record_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               User                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("medical_profiles")
}

model Organization {
  id                                                                   String                         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                                                                 String                         @db.VarChar(255)
  short_name                                                           String?                        @db.VarChar(50)
  organization_type                                                    organization_type
  barangay                                                             String?                        @db.VarChar(100)
  municipality                                                         String?                        @default("Bocaue") @db.VarChar(100)
  province                                                             String?                        @default("Bulacan") @db.VarChar(100)
  address                                                              String?
  location                                                             Unsupported("geography")?
  contact_number                                                       String?                        @db.VarChar(20)
  email                                                                String?                        @db.VarChar(255)
  operational_area                                                     Unsupported("geography")?
  is_active                                                            Boolean                        @default(true)
  joined_at                                                            DateTime                       @default(now()) @db.Timestamptz(6)
  created_at                                                           DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                                                           DateTime                       @default(now()) @db.Timestamptz(6)
  announcements                                                        Announcement[]
  dispatches                                                           dispatches[]
  facilities                                                           Facility[]
  ics_assignments                                                      ics_assignments[]
  incident_agency_participants                                         incident_agency_participants[]
  incident_messages                                                    incident_messages[]
  incident_metrics                                                     incident_metrics[]
  organization_memberships                                             organization_memberships[]
  resource_requests_resource_requests_providing_org_idToorganizations  ResourceRequest[]              @relation("resource_requests_providing_org_idToorganizations")
  resource_requests_resource_requests_requesting_org_idToorganizations ResourceRequest[]              @relation("resource_requests_requesting_org_idToorganizations")
  resources                                                            resources[]
  sla_policies                                                         sla_policies[]
  surge_incidents                                                      surge_incidents[]
  vehicles                                                             Vehicle[]

  @@index([organization_type], map: "idx_organizations_type")
  @@map("organizations")
}

model Incident {
  id                           String                         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  public_reference             String                         @unique @db.VarChar(30)
  trigger_method               trigger_method                 @default(SOS_BUTTON)
  client_event_id              String?                        @unique @db.VarChar(100)
  category                     incident_category
  priority                     incident_priority              @default(MEDIUM)
  status                       incident_status                @default(SUBMITTED)
  consciousness_state          consciousness_state?           @default(UNKNOWN)
  breathing_status             breathing_status?              @default(UNKNOWN)
  description                  String?
  number_of_patients           Int?                           @default(1) @db.SmallInt
  hazard_flags                 String[]
  river_level_meters           Decimal?                       @db.Decimal(5, 2)
  surge_incident_id            String?                        @db.Uuid
  is_surge_incident            Boolean                        @default(false)
  submitted_at                 DateTime                       @default(now()) @db.Timestamptz(6)
  received_at                  DateTime?                      @db.Timestamptz(6)
  acknowledged_at              DateTime?                      @db.Timestamptz(6)
  assessed_at                  DateTime?                      @db.Timestamptz(6)
  dispatch_pending_at          DateTime?                      @db.Timestamptz(6)
  dispatched_at                DateTime?                      @db.Timestamptz(6)
  en_route_at                  DateTime?                      @db.Timestamptz(6)
  on_scene_at                  DateTime?                      @db.Timestamptz(6)
  resolved_at                  DateTime?                      @db.Timestamptz(6)
  closed_at                    DateTime?                      @db.Timestamptz(6)
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  duplicate_of_id              String?                        @db.Uuid
  ai_suggestions               ai_suggestions[]
  alert_triggers               alert_triggers[]
  audit_logs                   AuditLog[]
  dispatches                   dispatches[]
  escalations                  Escalation[]
  facility_referrals           facility_referrals[]
  false_alerts                 false_alerts[]
  feedback_ratings             feedback_ratings[]
  incident_agency_participants incident_agency_participants[]
  incident_attachments         IncidentAttachment[]
  incident_command_structures  incident_command_structures?
  incident_details             incident_details?
  incident_events              IncidentEvent[]
  incident_handovers           incident_handovers[]
  incident_locations           incident_locations?
  barangay_notices             incident_barangay_notices[]
  incident_messages            incident_messages[]
  incident_metrics             incident_metrics?
  incident_patients            incident_patients[]
  incident_reporters           IncidentReporter?
  incident_resolutions         incident_resolutions?
  duplicate_of                 Incident?                      @relation("incident_duplicates", fields: [duplicate_of_id], references: [id], onUpdate: NoAction, map: "fk_incident_duplicate_of")
  duplicates                   Incident[]                     @relation("incident_duplicates")
  surge_incidents              surge_incidents?               @relation(fields: [surge_incident_id], references: [id], onUpdate: NoAction, map: "fk_surge_incident")
  location_history             location_history[]
  notifications                Notification[]
  offline_event_queue          offline_event_queue[]
  on_scene_assessments         on_scene_assessments[]
  fire_field_reports           fire_field_reports[]
  rescue_trip_reports          rescue_trip_reports[]
  resource_recommendations    resource_recommendations[]
  resource_requests            ResourceRequest[]
  resource_status_log          resource_status_log[]
  resources                    resources[]
  sensitive_data_access_log    sensitive_data_access_log[]
  transport_records            TransportRecord[]
  triage_tags                  triage_tags[]

  @@index([category], map: "idx_incidents_category")
  @@index([status, priority, submitted_at(sort: Desc)], map: "idx_incidents_composite")
  @@index([duplicate_of_id], map: "idx_incidents_duplicate_of")
  @@index([priority], map: "idx_incidents_priority")
  @@index([public_reference], map: "idx_incidents_reference")
  @@index([status], map: "idx_incidents_status")
  @@index([submitted_at(sort: Desc)], map: "idx_incidents_submitted_at")
  @@map("incidents")
}

model IncidentReporter {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incident_id      String   @unique @db.Uuid
  user_id          String?  @db.Uuid
  is_guest         Boolean  @default(false)
  reporter_name    String?  @db.VarChar(255)
  reporter_phone   String?  @db.VarChar(20)
  contact_callback String?  @db.VarChar(20)
  /// SAFE (reporting for others) or NEEDS_HELP (reporter is also hurt or in danger).
  reporter_status  String?  @db.VarChar(20)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  incidents        Incident @relation(fields: [incident_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            User?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([incident_id], map: "idx_reporters_incident")
  @@index([user_id], map: "idx_reporters_user")
  @@map("incident_reporters")
}

model IncidentAttachment {
  id                      String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incident_id             String              @db.Uuid
  uploaded_by_id          String?             @db.Uuid
  file_name               String              @db.VarChar(255)
  file_type               String              @db.VarChar(50)
  file_size_bytes         Int?
  storage_bucket          String              @db.VarChar(255)
  storage_key             String              @db.VarChar(500)
  storage_url             String?
  is_processed            Boolean             @default(false)
  uploaded_at             DateTime            @default(now()) @db.Timestamptz(6)
  capture_timestamp       DateTime?           @db.Timestamptz(6)
  capture_latitude        Decimal?            @db.Decimal(10, 7)
  capture_longitude       Decimal?            @db.Decimal(10, 7)
  capture_accuracy_meters Decimal?            @db.Decimal(8, 2)
  capture_source          String?             @db.VarChar(30)
  authenticity_score      Int?                @db.SmallInt
  authenticity_flags      String[]            @default([])
  authenticity_checked_at DateTime?           @db.Timestamptz(6)
  // Tier 2 — AI vision plausibility review (advisory only, never blocks dispatch).
  ai_review_label         String?             @db.VarChar(20)
  ai_review_reason        String?
  ai_review_checked_at    DateTime?           @db.Timestamptz(6)
  // A dispatcher's manual call that this piece of evidence isn't credible.
  // Attachment-level only — never changes the incident's own status.
  rejected_at             DateTime?           @db.Timestamptz(6)
  rejected_by_id          String?             @db.Uuid
  rejection_notes         String?
  incidents               Incident            @relation(fields: [incident_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                   User?               @relation("incident_attachments_uploaded_by_idTousers", fields: [uploaded_by_id], references: [id], onUpdate: NoAction)
  rejected_by             User?               @relation("incident_attachments_rejected_by_idTousers", fields: [rejected_by_id], references: [id], onUpdate: NoAction)
  incident_messages       incident_messages[]

  @@map("incident_attachments")
}

model IncidentEvent {
  id                String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incident_id       String           @db.Uuid
  from_status       incident_status?
  to_status         incident_status
  triggered_by_id   String?          @db.Uuid
  triggered_by_role user_role?
  notes             String?
  occurred_at       DateTime         @default(now()) @db.Timestamptz(6)
  incidents         Incident         @relation(fields: [incident_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             User?            @relation(fields: [triggered_by_id], references: [id], onUpdate: NoAction)

  @@index([incident_id, occurred_at(sort: Desc)], map: "idx_incident_events")
  @@map("incident_events")
}

model Vehicle {
  id               String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id  String        @db.Uuid
  plate_number     String?       @unique @db.VarChar(20)
  unit_code        String?       @db.VarChar(50)
  resource_type    resource_type
  make             String?       @db.VarChar(100)
  model            String?       @db.VarChar(100)
  year             Int?          @db.SmallInt
  capacity_persons Int?          @db.SmallInt
  is_active        Boolean       @default(true)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @default(now()) @db.Timestamptz(6)
  resources        resources[]
  organizations    Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("vehicles")
}

model Facility {
  id                      String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id         String?                   @db.Uuid
  name                    String                    @db.VarChar(255)
  facility_type           facility_type
  barangay                String?                   @db.VarChar(100)
  municipality            String?                   @db.VarChar(100)
  province                String?                   @db.VarChar(100)
  address                 String?
  latitude                Decimal?                  @db.Decimal(10, 7)
  longitude               Decimal?                  @db.Decimal(10, 7)
  location                Unsupported("geography")?
  location_status         facility_location_status  @default(UNVERIFIED)
  location_source         String?                   @db.VarChar(50)
  location_source_ref     String?                   @db.VarChar(100)
  location_confidence     Decimal?                  @db.Decimal(3, 2)
  location_verified_by_id String?                   @db.Uuid
  contact_number          String?                   @db.VarChar(20)
  emergency_contact       String?                   @db.VarChar(20)
  receiving_status        facility_receiving_status @default(UNKNOWN)
  /// C8: set only when a receiving status is reported (PATCH /v1/facilities/:id/status).
  receiving_status_updated_at DateTime?             @db.Timestamptz(6)
  capacity_total          Int?                      @db.SmallInt
  capacity_available      Int?                      @db.SmallInt
  has_emergency_room      Boolean?                  @default(false)
  has_icu                 Boolean?                  @default(false)
  blood_bank              Boolean?                  @default(false)
  is_evacuation_center    Boolean?                  @default(false)
  elevation_masl          Decimal?                  @db.Decimal(6, 1)
  is_active               Boolean                   @default(true)
  last_verified_at        DateTime?                 @db.Timestamptz(6)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  organizations           Organization?             @relation(fields: [organization_id], references: [id], onUpdate: NoAction)
  location_verified_by    User?                     @relation("FacilityLocationVerifiedBy", fields: [location_verified_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  facility_capabilities   facility_capabilities[]
  facility_referrals      facility_referrals[]
  transport_records       TransportRecord[]
  rescue_trip_reports     rescue_trip_reports[]

  @@index([location], map: "idx_facilities_location", type: Gist)
  @@index([location_status], map: "idx_facilities_location_status")
  @@map("facilities")
}

model TransportRecord {
  id                               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incident_id                      String             @db.Uuid
  dispatch_id                      String             @db.Uuid
  patient_id                       String?            @db.Uuid
  destination_id                   String?            @db.Uuid
  transport_started_at             DateTime?          @db.Timestamptz(6)
  estimated_arrival_at             DateTime?          @db.Timestamptz(6)
  arrived_at                       DateTime?          @db.Timestamptz(6)
  handover_completed_at            DateTime?          @db.Timestamptz(6)
  destination_changed              Boolean            @default(false)
  change_reason                    String?
  created_at                       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime           @default(now()) @db.Timestamptz(6)
  /// C17: crew-confirmed that the person carried is the registered reporter. Set and cleared
  /// together (CHECK in the migration). The reporter's own claim never sets it.
  reporter_patient_confirmed_at    DateTime?          @db.Timestamptz(6)
  reporter_patient_confirmed_by_id String?            @db.Uuid
  reporter_patient_confirmed_by    User?              @relation("TransportReporterPatientConfirmedBy", fields: [reporter_patient_confirmed_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  facilities                       Facility?          @relation(fields: [destination_id], references: [id], onUpdate: NoAction)
  dispatches                       dispatches         @relation(fields: [dispatch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  incidents                        Incident           @relation(fields: [incident_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  incident_patients                incident_patients? @relation(fields: [patient_id], references: [id], onUpdate: NoAction)

  @@map("transport_records")
}

model Notification {
  id                      String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incident_id             String?                   @db.Uuid
  recipient_user_id       String?                   @db.Uuid
  recipient_phone         String?                   @db.VarChar(20)
  channel                 notification_channel
  event_type              String                    @db.VarChar(100)
  title                   String?                   @db.VarChar(255)
  body                    String
  data_payload            Json?
