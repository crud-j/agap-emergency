# Expo + pnpm monorepo: hoist react-native and metro packages so that
# Metro's worker threads can resolve symlinked dependencies correctly.
# Without this, worker threads fail with "Cannot find module" errors on
# packages that exist but whose pnpm symlinks are not visible to CJS loaders
# spawned outside the workspace root context.
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=*@expo*
